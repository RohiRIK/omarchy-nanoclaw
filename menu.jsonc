// NanoClaw entries for the Omarchy menu (~/.config/omarchy/extensions/omarchy-menu.jsonc).
//
// `nanoclaw-integrate install` merges these for you (after asking) between
// "// >>> rohirik.nanoclaw" markers, with @PLUGIN@ replaced by this plugin's
// folder, and `nanoclaw-integrate remove` takes exactly that block out again.
// To merge by hand, copy the entries and replace @PLUGIN@ yourself.
{
  "setup.default.agent.nanoclaw": {"icon": "\ue000", "iconFont": "NanoClaw Icons", "label": "NanoClaw", "checked": "[[ \"$(omarchy-default-agent)\" == \"nanoclaw\" ]]", "action": "@PLUGIN@/bin/nanoclaw-default-agent set", "description": "Self-hosted container-isolated assistant"},
  "nanoclaw": {"parent": "setup", "icon": "", "iconFont": "NanoClaw Icons", "label": "NanoClaw", "aliases": ["ncl"], "description": "Self-hosted container-isolated assistant"},
  "nanoclaw.chat": {"icon": "󰭹", "label": "Chat", "aliases": ["ncl-chat"], "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-agent", "description": "Talk to your main agent in a terminal"},
  "nanoclaw.disposable": {"icon": "󰩺", "label": "Disposable agent", "aliases": ["ncl-disposable"], "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl disposable", "description": "Throwaway agent; everything is deleted when you exit"},
  "nanoclaw.agents": {"icon": "󰚩", "label": "Agents", "aliases": ["ncl-agents"], "description": "Your persistent agents"},
  "nanoclaw.agents.list": {"icon": "󰗊", "label": "List agents", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl agents", "description": "Every agent with its folder and provider"},
  "nanoclaw.agents.main": {"icon": "󰭹", "label": "Connect to terminal chat", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl main", "description": "Make your first agent answer Chat"},
  "nanoclaw.agents.tasks": {"icon": "󰃰", "label": "Scheduled tasks", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl tasks", "description": "Recurring work your agents run"},
  "nanoclaw.agents.approvals": {"icon": "󰄬", "label": "Approvals", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl approvals", "description": "Requests waiting for your decision"},
  "nanoclaw.templates": {"icon": "󰗀", "label": "New agent from template", "aliases": ["ncl-templates"], "description": "Public templates from nanocoai/nanoclaw-templates"},
  "nanoclaw.templates.catalog": {"icon": "󰗊", "label": "Browse catalog", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl templates", "description": "All public templates; * = installed"},
  "nanoclaw.templates.analyst": {"icon": "󰄨", "label": "Data analyst", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl template-create data/analyst", "description": "Installs data/analyst and creates an agent from it"},
  "nanoclaw.templates.code-architect": {"icon": "󰘦", "label": "Code architect", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl template-create engineering/code-architect", "description": "Installs engineering/code-architect and creates an agent from it"},
  "nanoclaw.templates.family-assistant": {"icon": "󰋑", "label": "Family assistant", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl template-create lifestyle/family-assistant", "description": "Installs lifestyle/family-assistant and creates an agent from it"},
  "nanoclaw.templates.journalist": {"icon": "󰎕", "label": "Journalist", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl template-create media/journalist", "description": "Installs media/journalist and creates an agent from it"},
  "nanoclaw.templates.competitor-analysis": {"icon": "󰳗", "label": "Competitor analysis", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl template-create product/competitor-analysis", "description": "Installs product/competitor-analysis and creates an agent from it"},
  "nanoclaw.templates.sdr": {"icon": "󰇮", "label": "Sales SDR", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl template-create sales/sdr", "description": "Installs sales/sdr and creates an agent from it"},
  "nanoclaw.channels": {"icon": "󰍡", "label": "Add channel", "aliases": ["ncl-channels"], "description": "Message your agents from other apps"},
  "nanoclaw.channels.telegram": {"icon": "", "label": "Telegram", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl channel telegram"},
  "nanoclaw.channels.whatsapp": {"icon": "󰖣", "label": "WhatsApp", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl channel whatsapp"},
  "nanoclaw.channels.discord": {"icon": "󰙯", "label": "Discord", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl channel discord"},
  "nanoclaw.channels.slack": {"icon": "󰒱", "label": "Slack", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl channel slack"},
  "nanoclaw.channels.signal": {"icon": "󰭹", "label": "Signal", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl channel signal"},
  "nanoclaw.channels.matrix": {"icon": "󰘨", "label": "Matrix", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl channel matrix"},
  "nanoclaw.channels.teams": {"icon": "󰊻", "label": "Microsoft Teams", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl channel teams"},
  "nanoclaw.channels.gchat": {"icon": "󰊫", "label": "Google Chat", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl channel gchat"},
  "nanoclaw.channels.mattermost": {"icon": "󰭻", "label": "Mattermost", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl channel mattermost"},
  "nanoclaw.channels.resend": {"icon": "󰇮", "label": "Email (Resend)", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl channel resend"},
  "nanoclaw.channels.github": {"icon": "", "label": "GitHub", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl channel github"},
  "nanoclaw.channels.linear": {"icon": "󰰍", "label": "Linear", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl channel linear"},
  "nanoclaw.providers": {"icon": "󰧑", "label": "Add provider", "aliases": ["ncl-providers"], "description": "Run agents on models other than Claude"},
  "nanoclaw.providers.codex": {"icon": "", "label": "Codex", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl provider codex", "description": "OpenAI, via ChatGPT subscription or API key"},
  "nanoclaw.providers.opencode": {"icon": "", "label": "OpenCode", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl provider opencode", "description": "OpenRouter, Google, DeepSeek and more"},
  "nanoclaw.providers.ollama": {"icon": "󰳆", "label": "Ollama", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl provider ollama-provider", "description": "Local open-weight models"},
  "nanoclaw.service": {"icon": "󰒓", "label": "Service", "aliases": ["ncl-service"], "description": "NanoClaw's background service"},
  "nanoclaw.service.start": {"icon": "󰐊", "label": "Start", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl service start"},
  "nanoclaw.service.stop": {"icon": "󰓛", "label": "Stop", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl service stop"},
  "nanoclaw.service.restart": {"icon": "󰑓", "label": "Restart", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl service restart"},
  "nanoclaw.service.status": {"icon": "󰗊", "label": "Status", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl service status"},
  "nanoclaw.service.logs": {"icon": "󰦪", "label": "Live logs", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl service logs", "description": "Follow the service log"},
  "nanoclaw.clean": {"icon": "󰃢", "label": "Clean up", "aliases": ["ncl-clean"], "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl clean", "description": "Remove leftover disposable agents, orphaned folders and stopped containers (asks first)"},
  "nanoclaw.preflight": {"icon": "󰗊", "label": "Health check", "aliases": ["ncl-health"], "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-menu --preflight", "description": "Docker, checkout, containers, image, and inference reachability"},
  "nanoclaw.install": {"icon": "󰇚", "label": "Setup or repair", "aliases": ["ncl-install"], "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl setup", "description": "Resume or repair NanoClaw's guided setup"},
  "nanoclaw.customize": {"icon": "󰏫", "label": "Customize with Claude", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl customize", "description": "Change how NanoClaw behaves (/customize)"},
  "nanoclaw.migrate": {"icon": "󰁯", "label": "Import from OpenClaw", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-ctl migrate-openclaw", "description": "Bring over your ~/.openclaw setup"},
  "nanoclaw.uninstall": {"icon": "󱐗", "label": "Preview uninstall", "aliases": ["ncl-uninstall"], "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-menu --uninstall-dry-run", "description": "Dry run: shows exactly what would be removed"},
  "nanoclaw.skills": {"icon": "󰚩", "label": "Management skills", "aliases": ["ncl-skills"], "description": "Provision NanoClaw management skills to your host agents"},
  "nanoclaw.skills.status": {"icon": "󰗊", "label": "Provisioning status", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-skills status", "description": "Which skills are provisioned to which agents"},
  "nanoclaw.skills.sync": {"icon": "󰇚", "label": "Sync skills", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-skills sync", "description": "Link global and personal skills into each agent's skills dir"},
  "nanoclaw.skills.dispose": {"icon": "󱐗", "label": "Dispose skill links", "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-skills dispose --all", "description": "Remove links this plugin created; sources are never touched"},
  "nanoclaw.bench": {"icon": "󰓅", "label": "Run container bench", "aliases": ["ncl-bench"], "action": "omarchy-launch-floating-terminal-with-presentation @PLUGIN@/bin/nanoclaw-runner bench", "description": "Isolation, resource caps, and --rm lifecycle checks"},
}
